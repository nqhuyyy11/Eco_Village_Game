# This .gitignore file is configured for Unity projects.
# Recommended: https://github.com/github/gitignore/blob/main/Unity.gitignore

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/

# Memory dumps
*.lldmp

# Scrap/Temporary files
/[Aa]ssets/AssetStoreTools*

# Visual Studio / Rider generated files
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File System Templates
/[Aa]ssets/Plugins/Editor/JetBrains*

# Crashlytics generated file
crashlytics-build.properties

# OS generated files
.DS_Store
Thumbs.db
