  m_Script: {fileID: 11500000, guid: 33b247df677e4134dab24e4c094cb87c, type: 3}
  m_Name: CuBa_AcceptB
  m_EditorClassIdentifier: Assembly-CSharp::EcoVillage.Dialogue.DialogueData
  dialogueID: CuBa_AcceptB
  lines:
  - speakerName: "Ng\u01B0\u1EDDi Ch\u01A1i"
    speakerPortrait: {fileID: 0}
    dialogueText: "Ch\xE1u... ch\xE1u c\u0169ng kh\xF4ng ch\u1EAFc m\xECnh l\xE0m
      \u0111\u01B0\u1EE3c kh\xF4ng c\u1EE5 \u01A1i."
    isPlayerChoice: 0
    triggerEventName: 
  - speakerName: "C\u1EE5 B\xE1"
    speakerPortrait: {fileID: 0}
    dialogueText: "Hehe... Ch\xE1u bi\u1EBFt kh\xF4ng, \xF4ng n\u1ED9i ch\xE1u ng\xE0y
      x\u01B0a khi g\u1EB7p kh\xF3 c\u0169ng n\xF3i y chang v\u1EADy. M\xE0 \u1ED5ng
      c\xF3 sao \u0111\xE2u \u2013 \u1ED5ng l\xE0 ng\u01B0\u1EDDi x\xE2y n\xEAn c\xE1i
      l\xE0ng n\xE0y \u0111\xF3!"
    isPlayerChoice: 0
    triggerEventName: 
  - speakerName: "Ng\u01B0\u1EDDi Ch\u01A1i"
    speakerPortrait: {fileID: 0}
    dialogueText: "... V\xE2ng. Ch\xE1u s\u1EBD c\u1ED1."
    isPlayerChoice: 0
    triggerEventName: 
  - speakerName: "C\u1EE5 B\xE1"
    speakerPortrait: {fileID: 0}
    dialogueText: "T\u1ED1t l\u1EAFm! V\u1EADy l\xE0 \u0111\u1EE7 r\u1ED3i. Th\xF4i,
      c\u1EE5 s\u1EBD ch\u1EC9 cho ch\xE1u bi\u1EBFt l\xE0m g\xEC tr\u01B0\u1EDBc
      nh\xE9."
    isPlayerChoice: 0
    triggerEventName: 
  branchDialogues: []
  nextDialogue: {fileID: 11400000, guid: 3fb3bf229b7ce1146acbaa4093fe39f5, type: 2}
  questToTrigger: {fileID: 0}
