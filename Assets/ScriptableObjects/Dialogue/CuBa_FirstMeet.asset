  dialogueID: CuBa_FirstMeet
  lines:
  - speakerName: "C\u1EE5 B\xE1"
    speakerPortrait: {fileID: 0}
    dialogueText: "\u1EE6a... Tr\u1EDDi \u01A1i, c\xF3 ph\u1EA3i... l\xE0 ch\xE1u
      kh\xF4ng?!"
    isPlayerChoice: 0
    triggerEventName: 
  - speakerName: "C\u1EE5 B\xE1"
    speakerPortrait: {fileID: 0}
    dialogueText: "Ch\xE0 ch\xE0 ch\xE0! Tr\xF4ng ch\xE1u b\xE2y gi\u1EDD kh\xE1c
      h\u1EB3n ng\xE0y b\xE9 r\u1ED3i! L\u1EDBn th\u1EADt r\u1ED3i \u0111\xF3...
      m\xE0 tr\xF4ng v\u1EABn gi\u1ED1ng c\xE1i h\u1ED3i c\xF2n ch\u1EA1y t\u1EAFm
      m\u01B0a tr\u01B0\u1EDBc s\xE2n \u0111\xECnh l\u1EAFm!"
    isPlayerChoice: 0
    triggerEventName: 
  - speakerName: "C\u1EE5 B\xE1"
    speakerPortrait: {fileID: 0}
    dialogueText: "C\u1EE5 vui l\u1EAFm khi ch\xE1u v\u1EC1... nh\u01B0ng...\nC\u1EE5
      c\u0169ng bu\u1ED3n l\u1EAFm khi ch\xE1u ph\u1EA3i th\u1EA5y c\u1EA3nh n\xE0y."
    isPlayerChoice: 0
    triggerEventName: 
  - speakerName: 
    speakerPortrait: {fileID: 0}
    dialogueText: 
    isPlayerChoice: 1
    triggerEventName: 
