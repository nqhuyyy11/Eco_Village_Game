  m_Script: {fileID: 11500000, guid: 33b247df677e4134dab24e4c094cb87c, type: 3}
  m_Name: CuBa_CleanTrash_Complete
  m_EditorClassIdentifier: Assembly-CSharp::EcoVillage.Dialogue.DialogueData
  dialogueID: CuBa_CleanTrash_Complete
  lines:
  - speakerName: "C\u1EE5 B\xE1"
    speakerPortrait: {fileID: 0}
    dialogueText: "C\u1EE5 kh\xF4ng ng\u1EDD... Ch\u1EC9 m\u1EA5y c\xE1i \u0111\u1ED1ng
      r\xE1c th\xF4i, m\xE0 d\u1ECDn xong r\u1ED3i l\u1EA1i th\u1EA5y con \u0111\u01B0\u1EDDng
      n\xE0y quen l\u1EAFm. H\u1ED3i nh\u1ECF c\u1EE5 ch\u1EA1y tr\xEAn con \u0111\u01B0\u1EDDng
      n\xE0y m\u1ED7i s\xE1ng \u0111\xF3..."
    isPlayerChoice: 0
    triggerEventName: 
  - speakerName: "C\u1EE5 B\xE1"
    speakerPortrait: {fileID: 0}
    dialogueText: "C\u1EA3m \u01A1n ch\xE1u. Thi\u1EC7t l\xF2ng c\u1EA3m \u01A1n.
      Ch\xE1u kh\xF4ng bi\u1EBFt c\u1EE5 vui \u0111\u1EBFn m\u1EE9c n\xE0o \u0111\xE2u."
    isPlayerChoice: 0
    triggerEventName: 
  - speakerName: "C\u1EE5 B\xE1"
    speakerPortrait: {fileID: 0}
    dialogueText: "\u0110\xE2y l\xE0 100 \u0111\u1ED3ng v\xE0ng c\u1EE5 d\xE0nh d\u1EE5m
      l\xE2u nay. Kh\xF4ng nhi\u1EC1u, nh\u01B0ng l\xE0 t\u1EA5t c\u1EA3 nh\u1EEFng
      g\xEC c\u1EE5 c\xF3. Ch\xE1u c\u1EA7m l\u1EA5y \u0111i \u0111\u01B0\u1EDDng."
    isPlayerChoice: 0
    triggerEventName: 
  branchDialogues: []
  nextDialogue: {fileID: 11400000, guid: 107543b52ae54c289f72e49766b3d69e, type: 2}
