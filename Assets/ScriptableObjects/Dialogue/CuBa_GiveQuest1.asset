  m_Script: {fileID: 11500000, guid: 33b247df677e4134dab24e4c094cb87c, type: 3}
  m_Name: CuBa_GiveQuest1
  m_EditorClassIdentifier: Assembly-CSharp::EcoVillage.Dialogue.DialogueData
  dialogueID: CuBa_GiveQuest1
  lines:
  - speakerName: "C\u1EE5 B\xE1"
    speakerPortrait: {fileID: 0}
    dialogueText: "Ch\xE1u \u01A1i, nh\xECn c\xE1i n\xE0y m\xE0 th\u1EA5y \u0111au
      l\xF2ng l\u1EAFm..."
    isPlayerChoice: 0
    triggerEventName: 
  - speakerName: "C\u1EE5 B\xE1"
    speakerPortrait: {fileID: 0}
    dialogueText: "Kh\xE1ch du l\u1ECBch v\xE3ng lai ng\xE0y tr\u01B0\u1EDBc \u0111\u1EC3
      l\u1EA1i \u0111\u1EA5y. Kh\xF4ng ai d\u1ECDn, n\xF3 c\u1EE9 ch\u1EA5t l\xEAn
      m\xE3i. N\u0103m \u0111\u1ED1ng l\u1EDBn th\u1EBF kia, ch\u1EB7n c\u1EA3 l\u1ED1i
      \u0111i v\xE0o l\xE0ng."
    isPlayerChoice: 0
    triggerEventName: 
  - speakerName: "C\u1EE5 B\xE1"
    speakerPortrait: {fileID: 0}
    dialogueText: "Ch\xE1u \u01A1i, mu\u1ED1n l\xE0ng \u0111\u1EB9p th\xEC tr\u01B0\u1EDBc
      ti\xEAn ph\u1EA3i s\u1EA1ch \u0111\xE3. Ch\xE1u c\xF3 th\u1EC3 gi\xFAp c\u1EE5
      d\u1ECDn 5 \u0111\u1ED1ng r\xE1c l\u1EDBn xung quanh khu v\u1EF1c l\u1ED1i
      v\xE0o kh\xF4ng?"
    isPlayerChoice: 0
    triggerEventName: 
  - speakerName: "C\u1EE5 B\xE1"
    speakerPortrait: {fileID: 0}
    dialogueText: "C\xE1i t\xFAi n\xE0y c\u1EE5 d\xF9ng h\u1ED3i c\xF2n tr\u1EBB.
      Ch\xE1u mang theo m\xE0 \u0111\u1EF1ng r\xE1c."
    isPlayerChoice: 0
    triggerEventName: QuestStarted
  branchDialogues: []
  nextDialogue: {fileID: 0}
  questToTrigger: {fileID: 11400000, guid: 0f7cdb68b5f4ccd45ab7104351d3350d, type: 2}
