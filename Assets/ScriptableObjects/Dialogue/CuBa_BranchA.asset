  lines:
  - speakerName: "Ng\u01B0\u1EDDi Ch\u01A1i"
    speakerPortrait: {fileID: 0}
    dialogueText: "Kh\xF4ng sao \u0111\xE2u c\u1EE5, ch\xE1u v\u1EC1 \u0111\u1EC3
      thay \u0111\u1ED5i t\u1EA5t c\u1EA3."
    isPlayerChoice: 0
    triggerEventName: 
  - speakerName: "C\u1EE5 B\xE1"
    speakerPortrait: {fileID: 0}
    dialogueText: "Heh heh... C\u1EE5 bi\u1EBFt ch\xE1u s\u1EBD n\xF3i v\u1EADy!
      Gi\u1ED1ng y chang \xF4ng n\u1ED9i ch\xE1u ng\xE0y x\u01B0a \u2013 c\xE1i l\u01B0\u1EE1i
      th\xEC m\u1EA1nh, nh\u01B0ng quan tr\u1ECDng l\xE0 c\xE1i tay ph\u1EA3i m\u1EA1nh
      h\u01A1n! Hehe..."
    isPlayerChoice: 0
    triggerEventName: 
